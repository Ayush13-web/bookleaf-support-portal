# --- Server ---
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# --- Database (PostgreSQL) ---
DATABASE_URL=postgres://bookleaf:bookleaf@localhost:5432/bookleaf
# Set to true for managed Postgres that requires TLS (Render, Railway, Neon...)
DATABASE_SSL=false

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# --- AI (optional: without a key the app degrades to rule-based triage + manual replies) ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
AI_TIMEOUT_MS=20000
